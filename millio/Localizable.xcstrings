    "monetization.cashback.categories.limit.hard_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Plan: bis zu %lld Cashback-Kategorien pro Monat. Upgrade auf PRO für unbegrenzte Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free plan: up to %lld cashback categories per month. Upgrade to PRO for unlimited categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan gratuito: hasta %lld categorías de cashback por mes. Mejora a PRO para categorías ilimitadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Free-план: до %lld категорий кешбэка в месяц. Оформите PRO для снятия лимита."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Free 方案每月最多可添加 %lld 个返现分类。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz plan: ayda en fazla %lld geri ödeme kategorisi. Sınırsız kategoriler için PRO'ya geçin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan gratuit : jusqu'à %lld catégories de cashback par mois. Passez à PRO pour des catégories illimitées."
          }
        }
      }
    },
