    "cashflow.budget.footer_hint.expense" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gesamtlimit hält den ganzen Monat im Blick, während Kategorielimits dort helfen, wo strengere Disziplin wichtig ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The total limit keeps the whole month in check, while category limits help where tighter discipline matters"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El límite total mantiene todo el mes bajo control, mientras que los límites por categoría ayudan donde la disciplina es más importante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite totale contrôle l'ensemble du mois, tandis que les limites par catégorie aident là où une discipline plus stricte est nécessaire"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий лимит помогает держать под контролем месяц целиком, а лимиты категорий нужны для точечной дисциплины"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplam limit tüm ayı kontrol altında tutarken kategori limitleri daha sıkı disiplin gereken yerlerde yardımcı olur"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总限额帮助把控整个月，分类限额则用于更细的约束"
          }
        }
      }
    },
    "cashflow.budget.footer_hint.income" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gesamtplan hält den Monat auf das Ergebnis fokussiert, während Kategorieziele zeigen, welche Einnahmequelle zurückliegt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The total plan keeps the month focused on the result, while category targets show which income source is lagging"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan total mantiene el mes enfocado en el resultado, mientras que los objetivos por categoría muestran qué fuente de ingreso va rezagada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'objectif total garde le mois concentré sur le résultat, tandis que les objectifs par catégorie montrent quelle source de revenus est en retard"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий план держит фокус на результате месяца, а планы по категориям показывают, какой источник дохода проседает"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplam plan ayı sonuca odaklarken kategori hedefleri hangi gelir kaynağının geride kaldığını gösterir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总计划帮助聚焦本月结果，分类目标则显示哪类收入落后"
          }
        }
      }
    },
    "cashflow.budget.hero.empty_hint" : {
      "extractionState" : "stale",
