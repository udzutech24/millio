          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除数值"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değeri sil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la valeur"
          }
        }
      }
    },
    "finances.audit.confirmation.delete_value.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Wert für das ausgewählte Datum wird für \"%@\" gelöscht. Diese Operation ist idempotent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the value for the selected date will be deleted for \"%@\". This operation is idempotent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminará el valor de la fecha seleccionada para \"%@\". Esta operación es idempotente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалится только значение за выбранную дату для «%@». Операция идемпотентна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除\"%@\"所选日期的数值，此操作可重复执行。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" için yalnızca seçilen tarihe ait değer silinecek. İşlem tekrarlanabilir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour «%@», seule la valeur de la date sélectionnée sera supprimée. L'opération est idempotente."
          }
        }
      }
    },
