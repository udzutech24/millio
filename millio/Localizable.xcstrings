    "finances.overview.expanded_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben auf Soll oder Haben, um eine Seite zu erweitern und Gruppen horizontal zu scrollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Debit or Credit above to expand one side and scroll groups horizontally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Débito o Crédito arriba para expandir un lado y desplazarte por los grupos horizontalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на Debit или Credit выше, чтобы раскрыть только одну сторону и пролистывать группы по горизонтали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击上方的 Debit 或 Credit，可只展开一侧并横向浏览分组。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarafı genişletmek ve grupları yatay kaydırmak için yukarıdaki Borç veya Kredi'ye dokunun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Débit ou Crédit ci-dessus pour développer un côté et faire défiler les groupes horizontalement."
          }
        }
      }
    },
