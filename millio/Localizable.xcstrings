    "cashflow.bulk_expense.help.step.balance.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the toggle is on, saving also adjusts the current card balance. Turn it off when you only need categorized history"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если переключатель включен, сохранение скорректирует текущий баланс карты. Выключи его, если нужна только история по категориям"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果开关已启用，保存时还会同步调整当前卡片余额。如果你只想补分类历史，就把它关掉"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Schalter aktiviert ist, passt das Speichern auch den aktuellen Kontostand an. Deaktiviere ihn, wenn du nur kategorisierte Historie benötigst"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.balance.title": {
      "comment": "Bulk expense import help step title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide whether to update card balance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши, обновлять ли баланс карты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定是否更新卡片余额"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide, ob Kontostand aktualisiert wird"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.categories.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In manual mode, enter the monthly total into each category. Numbers are formatted right away and large values shrink to stay readable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ручном режиме вноси итоговую сумму месяца в нужную категорию. Числа форматируются сразу, а большие значения ужимаются, чтобы оставаться читаемыми"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手动模式下，把每个分类的月度总额直接填进去。数字会立即格式化，长数字也会自动缩小以保持可读性"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im manuellen Modus gibst du das monatliche Gesamt für jede Kategorie ein. Zahlen werden sofort formatiert"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.categories.title": {
      "comment": "Bulk expense import help step title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill categories with monthly totals"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняй категории итогами месяца"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按月度总额填写分类"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien mit monatlichen Summen füllen"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.period.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a month and a card first. The import is tied to that exact pair, so reopening the screen shows the saved totals for the same month"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выбери месяц и карту. Импорт привязан именно к этой паре, поэтому при повторном открытии ты увидишь сохраненные суммы за тот же месяц"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择月份和卡片。导入结果会绑定到这组组合，所以你重新打开页面时会看到同一个月的已保存总额"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst einen Monat und eine Karte. Der Import ist an dieses Paar gebunden"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.period.title": {
      "comment": "Bulk expense import help step title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose period and card"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери период и карту"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择周期和卡片"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitraum und Karte wählen"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.save.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One card and one month keep a single category set. Saving again updates that set instead of creating duplicates"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для одной карты и одного месяца хранится один набор категорий. Повторное сохранение обновляет его, а не плодит дубли"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一张卡在同一个月份只保留一份分类集合。再次保存会更新这份集合，而不是制造重复数据"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte und ein Monat führen zu einem einzigen Kategoriesatz. Erneutes Speichern aktualisiert diesen Satz"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.save.title": {
      "comment": "Bulk expense import help step title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save without duplicates"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняй без дублей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无重复保存"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Duplikate speichern"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.screenshot.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot mode builds a review list first. Fix OCR mistakes, change categories, and only then move reviewed rows into monthly totals"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим скриншотов сначала строит список для проверки. Исправь ошибки OCR, смени категории и только потом переноси проверенные строки в месячные итоги"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图模式会先生成待审核列表。先修正 OCR 错误、调整分类，再把确认过的行合并到月度总额里"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Screenshot-Modus wird zuerst eine Prüfliste erstellt. OCR-Fehler beheben, Kategorien ändern und dann Zeilen übertragen"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.screenshot.title": {
