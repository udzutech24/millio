    "backup.restore.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle lokale Daten werden vollständig durch das ausgewählte Backup ersetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
