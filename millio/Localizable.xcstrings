            "value": "Verstanden"
          }
        }
      }
    },
    "finances.mass_import.instructions.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your broker or portfolio screen where ticker, market, quantity, and buy price are visible\nCapture clear screenshots without heavy blur, glare, or overlays\nA light background and full position list work better than cropped cards\nYou can add up to 8 screenshots, then review the detected rows before import"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте экран брокера или портфеля, где видны тикер, рынок, количество и цена покупки\nДелайте четкие скриншоты без сильного блюра, бликов и перекрытий\nЛучше использовать светлый фон и полный список позиций, а не обрезанные карточки\nМожно добавить до 8 скриншотов подряд, после чего проверьте найденные строки перед импортом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开能看到代码、市场、数量和买入价的券商或持仓页面\n截图要清晰，避免严重模糊、反光和遮挡\n浅色背景和完整持仓列表通常比裁剪卡片更容易识别\n最多可连续添加 8 张截图，导入前请先检查识别出的行"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne deinen Broker oder Portfolio-Bildschirm, auf dem Ticker, Markt, Menge und Kaufpreis sichtbar sind\nMache klare Screenshots ohne starke Unschärfe, Blendung oder Überlagerungen\nEin heller Hintergrund und vollständige Positionsliste funktionieren besser als beschnittene Karten\nDu kannst bis zu 8 Screenshots hinzufügen und dann die erkannten Zeilen vor dem Import prüfen"
          }
        }
      }
    },
    "finances.mass_import.instructions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To help the import recognize positions more accurately"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы импорт точнее распознал позиции"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了让导入更准确地识别持仓"
