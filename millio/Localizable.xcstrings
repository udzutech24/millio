    "finances.add_account.total_impact.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie Saldoänderungen das Gesamtergebnis aller Produkte beeinflussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines how balance changes affect the overall total across all products."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cómo los cambios de saldo afectan al total general de todos los productos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, как изменение баланса влияет на общий итог по всем продуктам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定义余额变动如何影响所有产品的总计。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiye değişikliklerinin tüm ürünlerdeki genel toplama nasıl etki ettiğini belirler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine comment les variations de solde influencent le total global de tous les produits."
          }
        }
      }
    },
