    },
    "cashflow.operation.help.note.category_month": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst den benötigten Monat, dann füge die Transaktion der richtigen Kategorie hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the needed month first, then add the operation into the right category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero el mes necesario, luego añade la operación en la categoría correcta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выбери нужный месяц, потом заноси операцию в правильную категорию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择所需月份，再将记录归入正确的类别。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce gerekli ayı seçin, ardından işlemi doğru kategoriye ekleyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord le mois souhaité, puis ajoutez l'opération dans la bonne catégorie."
          }
        }
      }
    },
    "cashflow.operation.help.note.currency_first": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst die Transaktionswährung, dann eine Karte oder ein Konto in derselben Währung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the operation currency first, then choose a card or account in the same currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero la moneda de la operación, luego selecciona una tarjeta o cuenta en la misma moneda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выбери валюту операции, потом карту или счет в этой же валюте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择交易货币，再选择同币种的卡片或账户。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce işlem para birimini seçin, ardından aynı para biriminde bir kart veya hesap seçin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord la devise de l'opération, puis sélectionnez une carte ou un compte dans la même devise."
          }
        }
      }
    },
    "cashflow.operation.help.note.expense_history": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der aktuelle Kontostand bereits korrekt ist, deaktiviere die Saldoaktualisierung und füge fehlende Ausgaben nur zur Historie hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the current card balance is already correct, turn off balance update and add the missing expenses only to history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el saldo actual de la tarjeta ya es correcto, desactiva la actualización de saldo y añade solo los gastos faltantes al historial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если текущий остаток карты уже верный, выключи обновление баланса и занеси пропущенные траты только в историю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若当前卡片余额已正确，请关闭余额更新，仅将缺失支出添加至历史记录。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kart bakiyesi zaten doğruysa bakiye güncellemesini kapatın ve yalnızca eksik giderleri geçmişe ekleyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le solde actuel de la carte est déjà correct, désactivez la mise à jour du solde et ajoutez uniquement les dépenses manquantes à l'historique."
          }
        }
      }
    },
    "cashflow.operation.help.note.income_history": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der aktuelle Saldo bereits korrekt ist, deaktiviere die Saldoaktualisierung und füge fehlende Einnahmen nur zur Historie hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the current balance is already correct, turn off balance update and add the missing income only to history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el saldo actual ya es correcto, desactiva la actualización de saldo y añade solo los ingresos faltantes al historial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если текущий остаток уже верный, выключи обновление баланса и занеси пропущенный доход только в историю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若当前余额已正确，请关闭余额更新，仅将缺失收入添加至历史记录。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bakiye zaten doğruysa bakiye güncellemesini kapatın ve yalnızca eksik gelirleri geçmişe ekleyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le solde actuel est déjà correct, désactivez la mise à jour du solde et ajoutez uniquement les revenus manquants à l'historique."
          }
        }
      }
    },
