        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или загрузи скриншоты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者导入截图"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
