    "cashflow.asset_change.explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies umfasst in der Regel Neubewertungen, Marktpreisbewegungen oder Vermögensaktivitäten, die nicht als Einnahmen oder Ausgaben erfasst wurden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually this includes revaluation, market price movement, or asset activity that was not recorded as income or expense"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente incluye revaluación, movimiento de precio de mercado o actividad de activos no registrada como ingreso o gasto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно сюда попадает переоценка, изменение рыночной цены или движение активов, которое не было записано как доход или расход"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常包括重估、市场价格变动或未记为收入或支出的资产变动"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genellikle yeniden değerleme, piyasa fiyatı hareketi veya gelir ya da gider olarak kaydedilmemiş varlık aktivitelerini içerir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut généralement la réévaluation, les mouvements de prix de marché ou l'activité d'actif non enregistrée en revenus ou dépenses"
          }
        }
      }
    },
    "cashflow.asset_change.formula": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderung = (Vermögen am Ende − Vermögen am Anfang) − Einnahmen + Ausgaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change = (Assets at end - Assets at start) - Income + Expenses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio = (Activos al final - Activos al inicio) - Ingresos + Gastos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение = (Активы на конец - Активы на начало) - Доходы + Расходы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变化 = （期末资产 - 期初资产）- 收入 + 支出"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişim = (Dönem sonu varlıklar - Dönem başı varlıklar) - Gelir + Giderler"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Variation = (Actifs fin - Actifs début) - Revenus + Dépenses"
          }
        }
      }
    },
    "cashflow.asset_change.formula_title": {
      "comment": "Cashflow asset change formula section title",
