    "cashflow.bulk_expense.help.crop.do": {
      "comment": "Positive screenshot cropping tip for bulk expense import help",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass 5–12 Ausgabenzeilen mit Händlernamen und Beträgen in einer Spalte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave 5-12 expense rows with merchant names and amounts in one column"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja 5-12 filas de gastos con nombres de comercios e importes en una columna"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляй 5-12 строк расходов с названиями магазинов и суммами в одной колонке"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一列里保留 5-12 行带商户名和金额的支出记录"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek sütunda satıcı adları ve tutarları olan 5-12 harcama satırı bırakın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez 5 à 12 lignes de dépenses avec les noms des marchands et les montants dans une colonne"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.crop.do_second": {
      "comment": "Second positive screenshot cropping tip for bulk expense import help",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständigen Betrag sichtbar lassen: `Supermarkt 1.240 €`, `Taxi 8,70 €`"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the full amount visible: `Grocery Store 1 240 ₽`, `Taxi 870 ₽`"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el importe completo visible: `Supermercado 1.240 €`, `Taxi 8,70 €`"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следи, чтобы сумма была видна целиком: `Пятерочка 1 240 ₽`, `Яндекс Такси 870 ₽`"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保金额完整可见，例如：`超市 1 240 ₽`、`打车 870 ₽`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam tutarı görünür tutun: `Market 1 240 ₽`, `Taksi 870 ₽`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le montant complet visible : `Épicerie 1 240 ₽`, `Taxi 870 ₽`"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.crop.dont": {
      "comment": "Negative screenshot cropping tip for bulk expense import help",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo, Kartenkarussell, Diagramme, Cashback-Banner und Navigationsleiste abschneiden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut off balance, cards carousel, charts, cashback banners, and bottom navigation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta el saldo, el carrusel de tarjetas, gráficos, banners de cashback y navegación inferior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезай баланс, карусель карт, графики, баннеры кешбэка и нижнюю навигацию"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁掉余额、卡片轮播、图表、返现横幅和底部导航"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
