    "cashflow.bulk_expense.help.crop.warning": {
      "comment": "Warning screenshot cropping tip for bulk expense import help",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers and top-ups may be recognized too. They go to `Transfers` and are highlighted in red for cleanup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы и пополнения тоже могут распознаться, они попадут в `Переводы` и будут подсвечены красным для проверки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账和充值也可能被识别出来。它们会进入 `Transfers`，并用红色标出供你清理"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen und Aufladungen können ebenfalls erkannt werden. Sie werden `Überweisungen` zugeordnet und rot markiert"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.hero.body": {
      "comment": "Help hero body for bulk expense import",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this screen to quickly record monthly expenses by category without creating every transaction one by one"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экран нужен для быстрого внесения месячных расходов по категориям без ручного создания каждой операции"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个页面用来按分类快速补录整月支出，不必逐笔创建交易"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze diesen Bildschirm, um monatliche Ausgaben nach Kategorie schnell zu erfassen, ohne jede Transaktion einzeln zu erstellen"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.open": {
      "comment": "Accessibility label for opening bulk import help",
      "extractionState": "manual",
      "localizations": {
        "en": {
