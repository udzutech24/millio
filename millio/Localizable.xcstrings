    "profile.contact.feedback_message": {
      "comment": "Support contact sheet message asking for screenshot + description and promising a 1-year subscription for user and friend if bug/idea is confirmed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found a bug or have a strong idea for improvement? Send us a screenshot and a short description. If we confirm the issue or ship the idea, you and your friend will get a 1-year subscription"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашли ошибку или придумали полезное улучшение? Отправьте нам скриншот и короткое описание. Если мы подтвердим проблему или реализуем идею, вы и ваш друг получите подписку на 1 год"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现问题，或有很好的改进建议？给我们发送截图和简短描述。如果我们确认问题或采纳这个想法，你和你的朋友都将获得 1 年订阅"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler gefunden oder eine gute Verbesserungsidee? Schick uns einen Screenshot und eine kurze Beschreibung. Wenn wir das Problem bestätigen oder die Idee umsetzen, erhaltet du und dein Freund ein 1-Jahres-Abonnement"
          }
        }
      }
    },
