          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот экран помогает спокойно восстановить месяц: выбери нужный месяц, занеси пропущенные траты и при этом не сломай текущие остатки."
          }
        }
      }
    },
