    "profile.rate_app.dialog.rate.message.app_store": {
      "comment": "Dialog message shown when user selects 5 stars and can open App Store review page",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Moment Zeit hast, unterstütze Millio mit einer Bewertung im App Store"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have a minute, please support Millio with a rating in the App Store"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes un minuto, apoya a Millio con una valoración en la App Store"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если будет минутка, поддержите «милью» оценкой в App Store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你有一分钟时间，欢迎在 App Store 给 Millio 一个评分"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dakikanız varsa lütfen App Store'da Millio'ya puan vererek destek olun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez une minute, soutenez Millio avec une note sur l'App Store"
          }
        }
      }
    },
