    "finances.audit.confirmation.delete_account.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto \"%@\" wird aus dem Verlauf und der aktuellen Datenbank gelöscht. Diese Operation ist irreversibel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account \"%@\" will be deleted from history and the current database. This operation is irreversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta \"%@\" se eliminará del historial y la base de datos actual. Esta operación es irreversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт «%@» будет удалён из истории и текущей базы. Операция необратима."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户\"%@\"将从历史记录和当前数据库中彻底删除，此操作不可撤销。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" hesabı geçmişten ve mevcut veritabanından silinecek. Bu işlem geri alınamaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte «%@» sera supprimé de l'historique et de la base de données actuelle. Cette action est irréversible."
          }
        }
      }
    },
    "finances.audit.confirmation.delete_value": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wert löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete value"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
