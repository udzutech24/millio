    "finances.convert_to_core.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erstellen im neuen Kern ein Konto mit dem aktuellen Saldo. Der Verlauf bleibt im Archiv des alten Kontos, und du kannst dies rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll create an account in the new core with the current balance. The history stays in the old account's archive, and you can undo this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crearemos una cuenta en el nuevo núcleo con el saldo actual. El historial permanece en el archivo de la cuenta antigua y puedes deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous créerons un compte dans le nouveau cœur avec le solde actuel. L'historique reste dans les archives de l'ancien compte, et vous pouvez annuler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создадим счёт в новом ядре с текущим балансом. История останется в архиве старого счёта, перевод можно отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni çekirdekte mevcut bakiyeyle bir hesap oluşturacağız. Geçmiş, eski hesabın arşivinde kalır ve bunu geri alabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们将在新核心中创建一个具有当前余额的账户。历史记录将保留在旧账户的归档中，此操作可以撤销。"
          }
        }
      }
    },
