        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de conversion %@ → %@ est indisponible. Certains montants ne sont pas inclus car l'API sélectionnée ne prend pas en charge ces devises."
          }
        }
      }
    },
