    "monetization.crypto.pro_message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiat-Währungen sind kostenlos. Kryptowährungen erfordern ein PRO-Abonnement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
