    "subscription.legal.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple Account at confirmation. Subscription renews automatically unless cancelled at least 24 hours before the end of the current period"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата спишется с Apple Account после подтверждения покупки. Подписка продлевается автоматически, если не отменить ее минимум за 24 часа до окончания текущего периода"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认购买后，费用将从你的 Apple 账户扣除。除非至少在当前订阅周期结束前 24 小时取消，否则订阅会自动续订"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung wird deinem Apple-Konto bei Bestätigung belastet. Abonnement verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt wird"
          }
        }
      }
    },
