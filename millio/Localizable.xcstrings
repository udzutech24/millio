    "cashflow.bulk_expense.help.step.save.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte und ein Monat führen zu einem einzigen Kategoriesatz. Erneutes Speichern aktualisiert diesen Satz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One card and one month keep a single category set. Saving again updates that set instead of creating duplicates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta y un mes mantienen un único conjunto de categorías. Guardar de nuevo actualiza ese conjunto en lugar de crear duplicados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для одной карты и одного месяца хранится один набор категорий. Повторное сохранение обновляет его, а не плодит дубли"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一张卡在同一个月份只保留一份分类集合。再次保存会更新这份集合，而不是制造重复数据"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kart ve bir ay tek bir kategori seti tutar. Tekrar kaydetmek kopya oluşturmak yerine bu seti günceller"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte et un mois conservent un seul ensemble de catégories. Enregistrer à nouveau met à jour cet ensemble au lieu de créer des doublons"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.save.title": {
      "comment": "Bulk expense import help step title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Duplikate speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save without duplicates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda sin duplicados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняй без дублей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无重复保存"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya olmadan kaydet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer sans doublons"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.screenshot.body": {
      "comment": "Bulk expense import help step body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Screenshot-Modus wird zuerst eine Prüfliste erstellt. OCR-Fehler beheben, Kategorien ändern und dann Zeilen übertragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot mode builds a review list first. Fix OCR mistakes, change categories, and only then move reviewed rows into monthly totals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo captura primero crea una lista de revisión. Corrige errores OCR, cambia categorías y solo entonces mueve las filas revisadas a los totales mensuales"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим скриншотов сначала строит список для проверки. Исправь ошибки OCR, смени категории и только потом переноси проверенные строки в месячные итоги"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图模式会先生成待审核列表。先修正 OCR 错误、调整分类，再把确认过的行合并到月度总额里"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü modu önce bir inceleme listesi oluşturur. OCR hatalarını düzeltin, kategorileri değiştirin ve ardından incelenen satırları aylık toplamlara taşıyın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode capture d'écran crée d'abord une liste de révision. Corrigez les erreurs OCR, changez les catégories, puis déplacez les lignes révisées dans les totaux mensuels"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.step.screenshot.title": {
      "comment": "Bulk expense import help step title",
