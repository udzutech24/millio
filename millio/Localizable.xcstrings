    "cashflow.editor.affect_balance.subtitle.expense": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere, wenn der aktuelle Saldo bereits korrekt ist und du nur die Ausgabenhistorie ergänzen möchtest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off if the current balance is already correct and you only need to backfill expense history for the selected period"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo si el saldo actual ya es correcto y solo necesitas rellenar el historial de gastos del período seleccionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключи, если текущий остаток уже верный и нужно только дозанести траты за выбранный период в историю"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果当前余额已经正确，只需要补录所选期间的支出历史，请关闭此开关"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bakiye zaten doğruysa ve yalnızca seçili dönem için gider geçmişini doldurmak istiyorsanız kapatın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez si le solde actuel est déjà correct et que vous souhaitez uniquement renseigner l'historique des dépenses pour la période sélectionnée"
          }
        }
      }
    },
    "cashflow.editor.affect_balance.subtitle.income": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere, wenn der aktuelle Saldo bereits korrekt ist und du nur die Einnahmenhistorie ergänzen möchtest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off if the current balance is already correct and you only need to backfill income history for the selected period"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo si el saldo actual ya es correcto y solo necesitas rellenar el historial de ingresos del período seleccionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключи, если текущий остаток уже верный и нужно только дозанести доходы за выбранный период в историю"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果当前余额已经正确，只需要补录所选期间的收入历史，请关闭此开关"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bakiye zaten doğruysa ve yalnızca seçili dönem için gelir geçmişini doldurmak istiyorsanız kapatın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez si le solde actuel est déjà correct et que vous souhaitez uniquement renseigner l'historique des revenus pour la période sélectionnée"
          }
        }
      }
    },
