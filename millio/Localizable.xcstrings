      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe to PRO to pick ready-made designs for your accounts. Account icon and colour stay free."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оформите PRO, чтобы выбирать готовые дизайны для счетов. Иконка и цвет счёта остаются доступны бесплатно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅 PRO 即可为账户选择现成设计。账户图标与颜色仍然免费。"
          }
        }
      }
    },
