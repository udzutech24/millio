    "backup.screen.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze deine Daten, stelle sie schnell wieder her und behalte manuelle Versionen vor riskanten Änderungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your data, restore it quickly, and keep manual versions before risky changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege tus datos, recupéralos rápidamente y guarda versiones manuales antes de cambios arriesgados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите данные, быстро восстановите их и сохраняйте ручные версии перед рискованными изменениями"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护你的数据、快速恢复，并在高风险改动前保留手动版本"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerinizi koruyun, hızlıca geri yükleyin ve riskli değişiklikler öncesi manuel sürümler saklayın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez vos données, restaurez-les rapidement et conservez des versions manuelles avant les changements risqués"
          }
        }
      }
    },
