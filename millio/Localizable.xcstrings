    "cashflow.display_currency.hint_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary currency can only be changed in Profile. Here, currency affects only the view and resets after leaving Cashflow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основную валюту можно менять только в Профиле. Здесь валюта влияет только на отображение и сбрасывается после выхода из Кэшфлоу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础货币只能在个人资料中更改。这里的货币只影响显示，并会在离开 Cashflow 后重置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hauptwährung kann nur im Profil geändert werden. Hier beeinflusst die Währung nur die Ansicht und wird nach dem Verlassen des Cashflows zurückgesetzt."
          }
        }
      }
    },
