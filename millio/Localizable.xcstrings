    "cashflow.budget.overflow.expense": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorielimits überschreiten das Gesamtlimit um %1$@ %2$@, daher kann diese Einstellung nicht gespeichert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category limits exceed the total by %1$@ %2$@, so this setup cannot be saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites por categoría superan el total en %1$@ %2$@, por lo que esta configuración no se puede guardar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимиты категорий превышают общий на %1$@ %2$@, такую конфигурацию нельзя сохранить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类限额超过总额 %1$@ %2$@，因此无法保存该配置"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori limitleri toplamı %1$@ %2$@ aşıyor, bu nedenle bu ayar kaydedilemez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites de catégorie dépassent le total de %1$@ %2$@, cette configuration ne peut donc pas être enregistrée"
          }
        }
      }
    },
