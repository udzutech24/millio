    "cashflow.asset_change.explanation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies umfasst in der Regel Neubewertungen, Marktpreisbewegungen oder Vermögensaktivitäten, die nicht als Einnahmen oder Ausgaben erfasst wurden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually this includes revaluation, market price movement, or asset activity that was not recorded as income or expense"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente incluye revaluación, movimiento de precio de mercado o actividad de activos no registrada como ingreso o gasto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно сюда попадает переоценка, изменение рыночной цены или движение активов, которое не было записано как доход или расход"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常包括重估、市场价格变动或未记为收入或支出的资产变动"
          }
        }
      }
    },
    "cashflow.asset_change.formula" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderung = (Vermögen am Ende − Vermögen am Anfang) − Einnahmen + Ausgaben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change = (Assets at end - Assets at start) - Income + Expenses"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio = (Activos al final - Activos al inicio) - Ingresos + Gastos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение = (Активы на конец - Активы на начало) - Доходы + Расходы"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "变化 = （期末资产 - 期初资产）- 收入 + 支出"
          }
        }
      }
    },
