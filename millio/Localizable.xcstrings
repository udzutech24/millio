    "cashflow.bulk_expense.help.step.save.body" : {
      "comment" : "Bulk expense import help step body",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Karte und ein Monat führen zu einem einzigen Kategoriesatz. Erneutes Speichern aktualisiert diesen Satz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One card and one month keep a single category set. Saving again updates that set instead of creating duplicates"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarjeta y un mes mantienen un único conjunto de categorías. Guardar de nuevo actualiza ese conjunto en lugar de crear duplicados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte et un mois conservent un seul ensemble de catégories. Enregistrer à nouveau met à jour cet ensemble au lieu de créer des doublons"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для одной карты и одного месяца хранится один набор категорий. Повторное сохранение обновляет его, а не плодит дубли"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kart ve bir ay tek bir kategori seti tutar. Tekrar kaydetmek kopya oluşturmak yerine bu seti günceller"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一张卡在同一个月份只保留一份分类集合。再次保存会更新这份集合，而不是制造重复数据"
          }
        }
      }
    },
