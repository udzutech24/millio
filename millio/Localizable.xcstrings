    "cashflow.bulk_expense.help.crop.warning": {
      "comment": "Warning screenshot cropping tip for bulk expense import help",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen und Aufladungen können ebenfalls erkannt werden. Sie werden `Überweisungen` zugeordnet und rot markiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers and top-ups may be recognized too. They go to `Transfers` and are highlighted in red for cleanup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias y recargas también pueden reconocerse. Van a `Transferencias` y se resaltan en rojo para limpieza"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы и пополнения тоже могут распознаться, они попадут в `Переводы` и будут подсвечены красным для проверки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账和充值也可能被识别出来。它们会进入 `Transfers`，并用红色标出供你清理"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferler ve para yüklemeleri de tanınabilir. `Transferler` kategorisine gider ve temizleme için kırmızıyla işaretlenir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les virements et les recharges peuvent également être reconnus. Ils vont dans `Virements` et sont surlignés en rouge pour nettoyage"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.hero.body": {
      "comment": "Help hero body for bulk expense import",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze diesen Bildschirm, um monatliche Ausgaben nach Kategorie schnell zu erfassen, ohne jede Transaktion einzeln zu erstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this screen to quickly record monthly expenses by category without creating every transaction one by one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esta pantalla para registrar rápidamente los gastos mensuales por categoría sin crear cada transacción una por una"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экран нужен для быстрого внесения месячных расходов по категориям без ручного создания каждой операции"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个页面用来按分类快速补录整月支出，不必逐笔创建交易"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her işlemi tek tek oluşturmadan aylık harcamaları kategoriye göre hızlıca kaydetmek için bu ekranı kullanın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez cet écran pour enregistrer rapidement les dépenses mensuelles par catégorie sans créer chaque transaction une par une"
          }
        }
      }
    },
    "cashflow.bulk_expense.help.open": {
