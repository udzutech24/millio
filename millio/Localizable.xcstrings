          "stringUnit": {
            "state": "translated",
            "value": "La tasa de conversión %@ → %@ no está disponible. Algunos importes no se incluyen porque la API seleccionada no admite estas monedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс конвертации %@ → %@ недоступен. Некоторые суммы не учтены, потому что выбранная API не поддерживает эти валюты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@ 的汇率不可用，部分金额未计入，因所选 API 不支持该货币。"
