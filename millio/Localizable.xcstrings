    "cashflow.asset_change.subtitle": {
      "comment": "Cashflow asset change info subtitle",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die Differenz zwischen Anfang und Ende des Zeitraums nach Berücksichtigung aller erfassten Einnahmen und Ausgaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the difference left between the start and end of the period after all recorded income and expenses are accounted for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la diferencia que queda entre el inicio y el final del período después de contabilizar todos los ingresos y gastos registrados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разница между началом и концом периода после учёта всех зафиксированных доходов и расходов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是在计入所有已记录收入和支出后，期初与期末之间剩余的差额"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kayıtlı gelir ve giderler hesaba katıldıktan sonra dönem başı ile sonu arasında kalan farktır"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la différence restante entre le début et la fin de la période après déduction de tous les revenus et dépenses enregistrés"
          }
        }
      }
    },
