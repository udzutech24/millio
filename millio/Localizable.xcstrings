    "backup.access.requires_sign_in.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in deinem Millio-Konto an, um mit Cloud-Backups zu arbeiten. Im Gastmodus bleiben Backups nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to your Millio account to work with cloud backups. In guest mode backups stay unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en tu cuenta de Millio para trabajar con las copias en la nube. En modo invitado las copias no están disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à votre compte Millio pour utiliser les sauvegardes cloud. En mode invité, elles restent indisponibles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в аккаунт Millio, чтобы работать с облачными копиями. В гостевом режиме копии недоступны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulut yedeklerini kullanmak için Millio hesabınızda oturum açın. Misafir modunda yedekler kullanılamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请登录 Millio 账户后使用云备份。访客模式下备份不可用。"
          }
        }
      }
    },
