    "cashflow.editor.save_failed.message": {
      "comment": "Message for failed cashflow transaction save alert",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde nicht gespeichert. Überprüfe Konto, Datum und verfügbares Guthaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction was not saved. Check the selected account, date, and available balance, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción no se guardó. Comprueba la cuenta seleccionada, la fecha y el saldo disponible, luego inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция не сохранена. Проверьте выбранный счёт, дату и доступный баланс, затем попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易未保存。请检查账户、日期和可用余额后重试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem kaydedilmedi. Seçili hesabı, tarihi ve mevcut bakiyeyi kontrol edip tekrar deneyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction n'a pas été enregistrée. Vérifiez le compte sélectionné, la date et le solde disponible, puis réessayez."
          }
        }
      }
    },
