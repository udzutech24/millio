    "profile.auth.connected.subtitle": {
      "comment": "Connected state subtitle",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontosynchronisierung ist für dieses Konto aktiviert. iCloud-Backup verwendet das aktuelle Apple-Konto auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account sync is enabled for this account. iCloud backup uses the current Apple account on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización de cuenta está activada. La copia de seguridad en iCloud usa la cuenta de Apple actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого аккаунта включена синхронизация. Резервные копии iCloud используют текущий Apple ID на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已启用同步。iCloud 备份使用本设备当前的 Apple 账户。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap için hesap senkronizasyonu etkinleştirildi. iCloud yedekleme, bu cihazdaki mevcut Apple hesabını kullanır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation du compte est activée pour ce compte. La sauvegarde iCloud utilise le compte Apple actuel sur cet appareil."
          }
        }
      }
    },
