    "cashflow.chart.hint_format": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Tippe auf einen Balken, um den Zeitraum zu prüfen. Bereich %lld hält Trends lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint: tap a bar to inspect the period. Range %lld keeps trends readable without noise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencia: toca una barra para inspeccionar el período. El rango %lld mantiene las tendencias legibles sin ruido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказка: нажмите на столбец, чтобы посмотреть период. Диапазон %lld помогает сравнивать динамику без перегруза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：点击柱状图查看该时段详情。范围 %lld 可使趋势清晰易读。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: dönemi incelemek için bir çubuğa dokunun. %lld aralığı trendleri gürültüsüz okunabilir tutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : appuyez sur une barre pour inspecter la période. La plage %lld maintient les tendances lisibles sans bruit."
          }
        }
      }
    },
