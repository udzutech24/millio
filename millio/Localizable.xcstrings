    "cashflow.budget.footer_hint.expense": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The total limit keeps the whole month in check, while category limits help where tighter discipline matters"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий лимит помогает держать под контролем месяц целиком, а лимиты категорий нужны для точечной дисциплины"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总限额帮助把控整个月，分类限额则用于更细的约束"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
