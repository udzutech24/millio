    "cashflow.main.empty_intro.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du, woher Geld kommt und wohin es geht. Füge deine erste Transaktion hinzu, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see where money comes from and where it goes. Add your first transaction to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes ver de dónde viene el dinero y adónde va. Añade tu primera transacción para empezar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь видно, откуда приходят деньги и куда уходят. Добавьте первую операцию, чтобы начать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里可以看到钱从哪里来、到哪里去。添加第一笔交易开始记录。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada paranın nereden geldiğini ve nereye gittiğini görebilirsiniz. Başlamak için ilk işleminizi ekleyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, vous pouvez voir d'où vient l'argent et où il va. Ajoutez votre première transaction pour commencer."
          }
        }
      }
    },
