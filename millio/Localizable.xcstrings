    "profile.auth.not_signed_in.subtitle": {
      "comment": "Signed-out auth state subtitle",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Apple anmelden, um Kontosynchronisierung zu aktivieren. iCloud-Backup funktioniert separat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple to enable account sync. iCloud backup works separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para activar la sincronización. La copia en iCloud funciona de forma independiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите через Apple ID, чтобы включить синхронизацию аккаунта. Резервные копии iCloud работают отдельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录即可启用账户同步。iCloud 备份独立工作。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap senkronizasyonunu etkinleştirmek için Apple ile oturum açın. iCloud yedekleme ayrı çalışır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple pour activer la synchronisation du compte. La sauvegarde iCloud fonctionne séparément."
          }
        }
      }
    },
