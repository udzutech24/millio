    "cashflow.budget.repeat.auto_hint.expense": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der neue Monat noch keine Limits hat, wird das Formular mit dem vorherigen Monat vorausgefüllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the new month has no limits yet, the form will be prefilled from the previous month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el nuevo mes no tiene límites aún, el formulario se rellenará desde el mes anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у нового месяца лимитов еще нет, форма сразу заполнится по прошлому месяцу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果新月份还没有限额，表单会自动按上个月预填。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ayın henüz limiti yoksa form önceki aydan doldurulacaktır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le nouveau mois n'a pas encore de limites, le formulaire sera pré-rempli à partir du mois précédent."
          }
        }
      }
    },
