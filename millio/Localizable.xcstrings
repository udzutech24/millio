          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Schließen werden Änderungen an Einnahmen, Ausgaben, Überweisungen und Importen gesperrt. Der Prüfverlauf bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing blocks income, expense, transfer and import changes. The audit history is retained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar se bloquean los cambios en ingresos, gastos, transferencias e importaciones. El historial de auditoría se conserva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После закрытия доходы, расходы, переводы и импорт будут заблокированы. История закрытия сохранится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后将阻止收入、支出、转账和导入更改，并保留审计历史。"
          }
        }
      }
    },
