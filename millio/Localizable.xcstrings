          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先选择所需月份，再将记录归入正确的类别。"
          }
        }
      }
    },
    "cashflow.operation.help.note.currency_first" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle zuerst die Transaktionswährung, dann eine Karte oder ein Konto in derselben Währung."
          }
        },
        "en" : {
