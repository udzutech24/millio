    "finances.add_account.total_impact.credit_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Gesamt wird das Feld Gesamtschuld verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Total, the Total debt field is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el Total se usa el campo Deuda total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для учета в «Итого» используется поле «Общий долг»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计入\"合计\"时使用\"总债务\"字段。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam için «Toplam borç» alanı kullanılır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ «Dette totale» est utilisé pour le total."
          }
        }
      }
    },
    "finances.add_account.total_impact.credit_remaining_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Gesamt wird das Feld Restschuld verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Total, the Remaining debt field is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el Total se usa el campo Deuda restante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для учета в «Итого» используется поле «Остаток долга»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计入\"合计\"时使用\"剩余债务\"字段。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam için «Kalan borç» alanı kullanılır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ «Solde restant» est utilisé pour le total."
          }
        }
      }
    },
    "finances.add_account.total_impact.debt_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Schulden: Wenn andere dir schulden, wähle Erhöht; wenn du schuldest, wähle Verringert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For debts: if others owe you, choose Increases; if you owe, choose Decreases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para deudas: si otros te deben, elige Aumenta; si tú debes, elige Disminuye."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для долгов: если вам должны — выбирайте «Увеличивает», если вы должны — «Уменьшает»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "债务：若别人欠你选\"增加\"，若你欠别人选\"减少\"。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borçlar için: başkaları size borçluysa «Artırır»ı, siz borçluyysanız «Azaltır»ı seçin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les dettes : si d'autres vous doivent de l'argent — choisissez «Augmente», si vous êtes débiteur — «Réduit»."
          }
        }
      }
    },
    "finances.add_account.total_impact.decreases": {
      "extractionState": "manual",
      "localizations": {
