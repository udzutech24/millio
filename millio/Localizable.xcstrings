        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нашли ошибку или придумали полезное улучшение? Отправьте нам скриншот и короткое описание. Если мы подтвердим проблему или реализуем идею, вы и ваш друг получите подписку на 1 год"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
