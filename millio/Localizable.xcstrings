    "cashflow.bulk_expense.help.crop.subtitle": {
      "comment": "Subtitle for screenshot cropping guide in bulk expense import help",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Parser arbeitet am besten, wenn der Rahmen nur Händlernamen und Beträge enthält"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parser works best when the frame contains only merchant names and amounts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El parser funciona mejor cuando el marco contiene solo nombres de comercios e importes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Парсер лучше всего работает, когда в кадре только названия магазинов и суммы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当画面里只剩商户名和金额时，识别效果最好"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıştırıcı, çerçeve yalnızca satıcı adları ve tutarlar içerdiğinde en iyi çalışır"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyseur fonctionne mieux lorsque le cadre contient uniquement les noms des marchands et les montants"
          }
        }
      }
    },
