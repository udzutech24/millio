    "cashflow.asset_change.subtitle": {
      "comment": "Cashflow asset change info subtitle",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the difference left between the start and end of the period after all recorded income and expenses are accounted for"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разница между началом и концом периода после учёта всех зафиксированных доходов и расходов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是在计入所有已记录收入和支出后，期初与期末之间剩余的差额"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die Differenz zwischen Anfang und Ende des Zeitraums nach Berücksichtigung aller erfassten Einnahmen und Ausgaben"
          }
        }
      }
