    "cashflow.asset_change.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually this includes revaluation, market price movement, or asset activity that was not recorded as income or expense"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно сюда попадает переоценка, изменение рыночной цены или движение активов, которое не было записано как доход или расход"
          }
        }
      }
    },
    "cashflow.asset_change.formula" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change = (Assets at end - Assets at start) - Income + Expenses"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение = (Активы на конец - Активы на начало) - Доходы + Расходы"
          }
        }
      }
    },
