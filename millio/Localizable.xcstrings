    "cashflow.chart.empty.banner.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn im ausgewählten Zeitraum Einnahmen und Ausgaben erscheinen, wird hier ein Trenddiagramm angezeigt, beginne mit deiner ersten Transaktion"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When income and expenses appear in the selected period, a trend chart will show up here, start with your first transaction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando aparezcan ingresos y gastos en el período seleccionado, aquí se mostrará un gráfico de tendencias; comienza con tu primera transacción"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в выбранном периоде появятся доходы и расходы, здесь появится динамика, начните с первой операции"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时段有收支记录后，趋势图将显示在此处，先添加第一笔交易吧"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili dönemde gelir ve giderler göründüğünde burada bir trend grafiği görünecektir, ilk işleminizle başlayın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque des revenus et des dépenses apparaîtront dans la période sélectionnée, un graphique de tendance s'affichera ici, commencez par votre première transaction"
          }
        }
      }
    },
