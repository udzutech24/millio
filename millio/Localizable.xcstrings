    "cashflow.history.detail.delete.balance_update_failed.message": {
      "comment": "Message shown when deleting a cashflow transaction with balance recalculation would make an account negative",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot update balances for \"%1$@\". Required: %2$@ %4$@. Available: %3$@ %4$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить балансы для \"%1$@\". Нужно: %2$@ %4$@. Доступно: %3$@ %4$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新\"%1$@\"的余额。需要：%2$@ %4$@，可用：%3$@ %4$@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Salden für \"%1$@\" können nicht aktualisiert werden. Benötigt: %2$@ %4$@. Verfügbar: %3$@ %4$@."
          }
        }
      }
    },
    "cashflow.history.detail.delete.balance_update_failed.title": {
      "comment": "Title for failed balance recalculation after deleting a cashflow transaction",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot update balances"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить балансы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新余额"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Salden können nicht aktualisiert werden"
          }
        }
      }
    },
    "cashflow.history.detail.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With recalculation, account balances are updated. Without recalculation, only history entry is deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С пересчетом обновятся остатки затронутых счетов. Без пересчета удалится только запись в истории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新计算将更新账户余额；不重新计算则仅删除历史记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Neuberechnung werden Kontosalden aktualisiert. Ohne Neuberechnung wird nur der Historieneintrag gelöscht."
          }
        }
      }
    },
