            "state": "translated",
            "value": "Mejor para copia real. Usa la misma frase en un nuevo dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучший вариант для настоящей резервной копии. Используйте ту же кодовую фразу на новом устройстве"
          }
        },
        "zh-Hans": {
          "stringUnit": {
