    "finances.overview.hints.ledger_sides" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haben und Soll werden als linke und rechte Seite angezeigt: Haben links, Soll rechts. Kreditkarten und Kredite bleiben als Verbindlichkeiten links."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credit and debit are shown as left and right sides: credit on the left, debit on the right. Credit cards and loans stay on the left as liabilities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El crédito y el débito se muestran como lados izquierdo y derecho: crédito a la izquierda, débito a la derecha. Las tarjetas de crédito y préstamos permanecen a la izquierda como pasivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le crédit et le débit sont affichés comme côté gauche et droit : le crédit à gauche, le débit à droite. Les cartes de crédit et les prêts restent à gauche comme passifs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кредит и дебит показаны как левая и правая стороны: кредит слева, дебит справа. Кредитные карты и кредиты — слева как обязательства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredi ve borç sol ve sağ taraf olarak gösterilir: kredi solda, borç sağda. Kredi kartları ve krediler yükümlülük olarak solda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credit 和 debit 分别显示在左右两侧: credit 在左，debit 在右。信用卡和贷款作为负债保留在左侧。"
          }
        }
      }
    },
