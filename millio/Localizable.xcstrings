    "finances.add_account.total_impact.debt_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For debts: if others owe you, choose Increases; if you owe, choose Decreases."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для долгов: если вам должны — выбирайте «Увеличивает», если вы должны — «Уменьшает»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "债务：若别人欠你选\"增加\"，若你欠别人选\"减少\"。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Schulden: Wenn andere dir schulden, wähle Erhöht; wenn du schuldest, wähle Verringert."
