    "cashflow.history.detail.delete.balance_update_failed.message": {
      "comment": "Message shown when deleting a cashflow transaction with balance recalculation would make an account negative",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Salden für \"%1$@\" können nicht aktualisiert werden. Benötigt: %2$@ %4$@. Verfügbar: %3$@ %4$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot update balances for \"%1$@\". Required: %2$@ %4$@. Available: %3$@ %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden actualizar los saldos de \"%1$@\". Necesario: %2$@ %4$@. Disponible: %3$@ %4$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить балансы для \"%1$@\". Нужно: %2$@ %4$@. Доступно: %3$@ %4$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新\"%1$@\"的余额。需要：%2$@ %4$@，可用：%3$@ %4$@。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" için bakiyeler güncellenemiyor. Gerekli: %2$@ %4$@. Mevcut: %3$@ %4$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour les soldes pour « %1$@ ». Requis : %2$@ %4$@. Disponible : %3$@ %4$@."
          }
        }
      }
    },
    "cashflow.history.detail.delete.balance_update_failed.title": {
      "comment": "Title for failed balance recalculation after deleting a cashflow transaction",
      "extractionState": "stale",
      "localizations": {
