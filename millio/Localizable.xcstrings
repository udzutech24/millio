    "cashflow.bulk_expense.screenshot.hint": {
      "comment": "Screenshot import hint",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Bank-Screenshots hoch, prüfe die erkannten Zeilen und übertrage sie dann in die Monatskategorien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload bank screenshots, review the recognized rows, and only then move them into the month categories"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube capturas bancarias, revisa las filas reconocidas y solo entonces muévelas a las categorías del mes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузи банковские скриншоты, проверь распознанные строки и только потом переноси их в категории месяца"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传银行截图，先检查识别出的行，再把它们合并到当月分类里"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka ekran görüntülerini yükleyin, tanınan satırları inceleyin ve ardından ay kategorilerine taşıyın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez des captures d'écran bancaires, révisez les lignes reconnues, puis déplacez-les dans les catégories du mois"
          }
        }
      }
    },
