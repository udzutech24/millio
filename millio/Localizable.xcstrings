    "backup.restore.empty.message.icloud_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne iCloud-Zugriff kann Millio keine Backups prüfen oder Daten wiederherstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without iCloud access, Millio cannot check backups or restore data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a iCloud, Millio no puede comprobar copias ni restaurar datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans accès à iCloud, Millio ne peut ni vérifier les sauvegardes ni restaurer les données"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без доступа к iCloud Millio не может проверить копии и восстановить данные"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud erişimi olmadan Millio yedekleri kontrol edemez ve verileri geri yükleyemez"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 iCloud 访问权限，Millio 无法检查备份或恢复数据"
          }
        }
      }
    },
