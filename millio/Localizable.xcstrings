    "finances.mass_import.mode.screenshot.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade bis zu 8 Screenshots hoch und wir erstellen Entwurfspositionen und markieren mehrdeutige Zeilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload up to 8 screenshots and we will build draft positions and flag ambiguous rows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hasta 8 capturas y crearemos posiciones borrador y marcaremos las filas ambiguas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите до 8 кадров, а мы соберем черновик позиций и отметим спорные строки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多上传 8 张截图，我们会生成持仓草稿并标出有歧义的行。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 adede kadar ekran görüntüsü yükleyin, taslak pozisyonlar oluşturalım ve belirsiz satırları işaretleyelim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez jusqu'à 8 captures d'écran et nous créerons des positions provisoires et signalerons les lignes ambiguës."
