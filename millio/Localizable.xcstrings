    "finances.purge_legacy.confirm.message_format" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto und die zugehörigen Vorgänge (%lld) werden endgültig gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account and its related operations (%lld) will be permanently deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta y sus operaciones relacionadas (%lld) se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte et ses opérations associées (%lld) seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счёт и связанные операции (%lld) будут удалены безвозвратно. Действие необратимо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap ve ilişkili işlemler (%lld) kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户及其相关操作（%lld 项）将被永久删除。此操作无法撤销。"
          }
        }
      }
    },
