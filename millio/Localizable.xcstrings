    "finances.main.empty_intro.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle Konten und Karten, füge Aktien, Krypto, Immobilien und andere Produkte in einer übersichtlichen Oberfläche hinzu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create accounts and cards, add stocks, crypto, real estate, and any other products in one streamlined interface"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea cuentas y tarjetas, añade acciones, cripto, inmuebles y cualquier otro producto en una interfaz fluida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des comptes et des cartes, ajoutez des actions, des cryptos, de l'immobilier et tout autre produit dans une interface simple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте счета и карты, добавляйте акции, криптовалюту, недвижимость и любые другие продукты в одном удобном интерфейсе"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir kullanışlı arayüzden hesap ve kartlar oluşturun, hisse senedi, kripto, gayrimenkul ve diğer ürünleri ekleyin"
          }
        },
        "zh-Hans" : {
