    "cashflow.history.detail.delete.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Neuberechnung werden Kontosalden aktualisiert. Ohne Neuberechnung wird nur der Historieneintrag gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With recalculation, account balances are updated. Without recalculation, only history entry is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con recálculo, los saldos de cuenta se actualizan. Sin recálculo, solo se elimina el registro del historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec recalcul, les soldes des comptes sont mis à jour. Sans recalcul, seule l'entrée d'historique est supprimée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С пересчетом обновятся остатки затронутых счетов. Без пересчета удалится только запись в истории."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden hesaplamayla hesap bakiyeleri güncellenir. Yeniden hesaplama olmadan yalnızca geçmiş kaydı silinir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新计算将更新账户余额；不重新计算则仅删除历史记录。"
          }
        }
      }
    },
