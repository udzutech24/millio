    "cashflow.display_currency.hint_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hauptwährung kann nur im Profil geändert werden. Hier beeinflusst die Währung nur die Ansicht und wird nach dem Verlassen des Cashflows zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary currency can only be changed in Profile. Here, currency affects only the view and resets after leaving Cashflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La moneda principal solo puede cambiarse en Perfil. Aquí, la moneda afecta solo la vista y se restablece al salir del Flujo de caja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основную валюту можно менять только в Профиле. Здесь валюта влияет только на отображение и сбрасывается после выхода из Кэшфлоу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础货币只能在个人资料中更改。这里的货币只影响显示，并会在离开 Cashflow 后重置。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birincil para birimi yalnızca Profil'den değiştirilebilir. Burada para birimi yalnızca görünümü etkiler ve Nakit Akışı'ndan çıkıldığında sıfırlanır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La devise principale ne peut être modifiée que dans le Profil. Ici, la devise n'affecte que l'affichage et se réinitialise après avoir quitté la Trésorerie."
          }
        }
      }
    },
