{
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf ./*)",
      "Bash(sudo rm*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(export*|*curl*)",
      "Bash(printenv*|*curl*)",
      "Bash(env*|*curl*)",
      "Bash(export*|*wget*)",
      "Bash(*.env*|*curl*)",
      "Bash(git push*--force*main*)",
      "Bash(git push*--force*master*)",
      "Bash(git push*-f*main*)",
      "Bash(git push*-f*master*)",
      "Bash(git push*--force-with-lease*main*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit*-n *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh\" 2>/dev/null || echo '[self-check] Self-audit пройден? Gates зелёные? Acceptance criteria покрыты? Рефлексия в .business/история/? Идеи — в improvements/?' >&2"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/telemetry-session.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_TOOL_INPUT\" in *\"rm -rf\"*|*\"--force\"*main*|*\"--force\"*master*|*\"reset --hard\"*|*\"git clean -fd\"*) echo '[WARN] Потенциально разрушительная команда — убедись что пользователь подтвердил.' >&2 ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
