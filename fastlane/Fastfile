default_platform(:ios)

platform :ios do
  desc "Build and upload the app to TestFlight"
  lane :release_testflight do |options|
    scheme = options[:scheme] || "millio"
    configuration = options[:configuration] || "Release"
    asc_api_key = app_store_connect_api_key_from_env

    sync_code_signing(
      type: "appstore",
      readonly: options[:readonly_signing] != false,
      app_identifier: [
        "com.millio.app",
        "com.millio.app.currencywidget"
      ]
    ) if options[:use_match]

    new_build_number = resolve_build_number(
      api_key: asc_api_key,
      version: get_version_number(
        xcodeproj: "millio.xcodeproj",
        target: "millio"
      )
    )

    increment_build_number(
      xcodeproj: "millio.xcodeproj",
      build_number: new_build_number
    )

    build_ios_app(
      project: "millio.xcodeproj",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      clean: true,
      include_symbols: true,
      include_bitcode: false,
      output_directory: "build/testflight",
      output_name: "millio.ipa"
    )

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "build/testflight/millio.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )

    git_commit(
      path: [
        "millio.xcodeproj/project.pbxproj",
        "millioCurrencyWidgetExtension/Info.plist"
      ],
      message: "chore(build): bump build number to #{new_build_number}"
    )
  end

  desc "Генерирует сырые App Store скриншоты через Screenshot Mode + fastlane snapshot.
  После захвата: cd Маркетинг/screenshots-remotion && npm run render — финальные карточки.
  Запуск: bundle exec fastlane screenshots"
  lane :screenshots do
    capture_screenshots(
      override_status_bar: true,
      override_status_bar_arguments: "--time 9:41 --batteryState charged --batteryLevel 100 --wifiBars 3 --cellularMode active --cellularBars 4"
    )
  end

  desc "Загружает скриншоты App Store из fastlane/screenshots/ (EN + RU, iPhone67Display).
  Запуск: bundle exec fastlane upload_screenshots"
  lane :upload_screenshots do |options|
    asc_api_key = app_store_connect_api_key_from_env

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: "com.millio.app",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Загружает App Preview видео из fastlane/app_previews/ (EN + RU, iPhone67Display).
  Ожидает: fastlane/app_previews/{en-US,ru}/iPhone67Display/AppPreview-1.mp4
  Источник: Маркетинг/screenshots-remotion/out/preview/{EN,RU}.mp4
  Запуск: bundle exec fastlane upload_previews"
  lane :upload_previews do |options|
    asc_api_key = app_store_connect_api_key_from_env

    # Копируем отрендеренные видео из out/{locale}/preview.mp4 в структуру fastlane
    remotion_out = File.expand_path("../../Маркетинг/screenshots-remotion/out", __dir__)
    previews_base = File.expand_path("fastlane/app_previews", Dir.pwd)

    ["en-US", "ru"].each do |locale|
      src = File.join(remotion_out, locale, "preview.mp4")
      dst_dir = File.join(previews_base, locale, "iPhone67Display")
      FileUtils.mkdir_p(dst_dir)
      FileUtils.cp(src, File.join(dst_dir, "AppPreview-1.mp4"))
      UI.message("Скопировано #{locale}/preview.mp4 → fastlane/app_previews/#{locale}/iPhone67Display/AppPreview-1.mp4")
    end

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: "com.millio.app",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      screenshots_path: "fastlane/app_previews",
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Загружает метаданные App Store (описания, ключевые слова, release notes) из fastlane/metadata/ без бинарника.
  Запуск: bundle exec fastlane upload_metadata
  Флаги: skip_screenshots:true (по умолчанию), force:true — без подтверждения"
  lane :upload_metadata do |options|
    asc_api_key = app_store_connect_api_key_from_env

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: "com.millio.app",
      skip_binary_upload: true,
      skip_screenshots: options[:skip_screenshots] != false,
      skip_metadata: false,
      metadata_path: "fastlane/metadata",
      force: options[:force] || false,
      overwrite_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      languages: ["en-US", "ru", "zh-Hans", "de-DE", "es-ES"]
    )
  end

  desc "Distribute already-uploaded build to internal testers (millio group)"
  lane :distribute do |options|
    asc_api_key = app_store_connect_api_key_from_env
    build = options[:build] || get_build_number(xcodeproj: "millio.xcodeproj")
    version = get_version_number(xcodeproj: "millio.xcodeproj", target: "millio")

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: "com.millio.app",
      distribute_only: true,
      build_number: build.to_s,
      app_version: version,
      groups: ["millio"],
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: false
    )
  end
end

def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

  return nil if [key_id, issuer_id].any?(&:nil?)
  return nil if key_content.to_s.empty? && key_filepath.to_s.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    key_filepath: key_filepath,
    is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_BASE64"] == "1",
    duration: 1200,
    in_house: false
  )
end

def resolve_build_number(api_key:, version:)
  latest_remote = nil

  begin
    latest_remote = app_store_build_number(
      app_identifier: "com.millio.app",
      version: version,
      live: false,
      api_key: api_key,
      initial_build_number: 0
    )
  rescue => error
    UI.important("Could not fetch latest TestFlight build number: #{error.message}")
  end

  if latest_remote
    latest_remote.to_i + 1
  else
    local_build = get_build_number(xcodeproj: "millio.xcodeproj").to_i
    local_build + 1
  end
end
